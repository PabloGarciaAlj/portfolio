---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
  >
    <p>© {year} {profile.name}</p>
    <p>{profile.location}</p>
  </div>
</footer>
