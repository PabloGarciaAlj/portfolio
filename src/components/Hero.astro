---
import { Picture } from 'astro:assets';
import { DownloadSimple } from '@phosphor-icons/react/ssr';
import portrait from '../assets/foto_perfil.jpg';
import { getContent } from '../data/profile';
import { getLang, sectionId, useTranslations } from '../i18n/ui';
import CvLanguage from './CvLanguage.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { profile } = getContent(lang);
---

<section
  aria-labelledby="hero-title"
  class="mx-auto grid max-w-6xl gap-12 px-4 pt-12 pb-20 sm:px-6 md:grid-cols-12 md:items-center md:gap-10 md:pt-20 md:pb-16 lg:px-8"
>
  <div class="md:col-span-7">
    <p class="rise flex items-center gap-2.5 font-mono text-[0.8125rem] text-muted" style="--i: 0">
      <span class="relative flex size-2" aria-hidden="true">
        <span class="size-2 rounded-full bg-accent"></span>
      </span>
      {profile.availability}
    </p>

    <h1
      id="hero-title"
      class="rise mt-6 text-5xl leading-[0.95] font-bold tracking-[-0.035em] text-balance sm:text-6xl lg:text-7xl"
      style="--i: 1"
    >
      {profile.name}
    </h1>

    <p class="rise mt-6 max-w-[34rem] text-lg leading-relaxed text-muted sm:text-xl" style="--i: 2">
      <span class="block font-medium text-ink">
        {
          profile.role.split(' · ').map((part, i) => (
            <Fragment>
              {i > 0 && ' · '}
              <span class="whitespace-nowrap">{part}</span>
            </Fragment>
          ))
        }
      </span>
      {profile.positioning}
    </p>

    <div class="rise mt-9 flex flex-wrap gap-3" style="--i: 3">
      <a href={`#${sectionId('projects', lang)}`} class="btn btn-primary">{t.hero.viewProjects}</a>
      <a href={profile.cv} download hreflang="es" class="btn btn-secondary">
        <DownloadSimple size={18} weight="bold" aria-hidden="true" />
        {t.hero.downloadCv}
        <CvLanguage />
      </a>
    </div>
  </div>

  <div class="rise md:col-span-5" style="--i: 2">
    <Picture
      src={portrait}
      alt={t.hero.portraitAlt}
      width={960}
      widths={[360, 560, 760, 960]}
      sizes="(min-width: 1152px) 440px, (min-width: 768px) 38vw, 92vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="aspect-square w-full rounded-xl md:aspect-[4/5] object-cover object-[50%_30%] md:ml-auto md:max-w-[440px]"
    />
  </div>
</section>
