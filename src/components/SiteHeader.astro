---
import { profile } from '../data/profile';

const links = [
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#experiencia', label: 'Experiencia', wide: true },
  { href: '/#habilidades', label: 'Habilidades', wide: true },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header
  class="sticky top-0 z-40 border-b border-line bg-canvas/85 backdrop-blur-md supports-[not(backdrop-filter:blur(0))]:bg-canvas"
>
  <nav
    aria-label="Principal"
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8"
  >
    <a href="/" class="font-medium tracking-tight whitespace-nowrap">
      {profile.name}
    </a>
    <ul class="flex items-center gap-5 text-[0.9375rem] text-muted sm:gap-7">
      {
        links.map((link) => (
          <li class={link.wide ? 'hidden md:block' : undefined}>
            <a href={link.href} class="transition-colors duration-200 hover:text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
