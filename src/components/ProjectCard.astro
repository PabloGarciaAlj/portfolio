---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { ArrowUpRight } from '@phosphor-icons/react/ssr';
import MediaPlaceholder from './MediaPlaceholder.astro';
import { contextLabel } from '../lib/projects';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Wide card with a media slot next to the text. */
  media?: { kind: 'image' | 'model'; label: string };
  reverse?: boolean;
  /**
   * Narrow card (TFG on the landing): half image, half text, no summary and a
   * larger title, fewer tags. One message, a short card, and the sides free
   * for the katana behind it. The summary lives on the project page.
   */
  narrow?: boolean;
  headingLevel?: 'h3' | 'h4';
  class?: string;
}

const { project, media, reverse = false, narrow = false, headingLevel = 'h3', class: className } = Astro.props;
const { title, summary, context, year, stack, cover } = project.data;
const Heading = headingLevel;
const visibleStack = stack.slice(0, narrow ? 4 : 6);
const mediaSpan = narrow ? 'md:col-span-6' : 'md:col-span-7';
const textSpan = narrow ? 'md:col-span-6' : 'md:col-span-5';
const hiddenCount = stack.length - visibleStack.length;
---

<a
  href={`/proyectos/${project.id}/`}
  class:list={[
    'group flex flex-col rounded-xl border border-line bg-surface transition-[border-color,transform] duration-200 ease-out hover:border-line-strong active:scale-[0.995]',
    media ? 'p-3 md:p-4' : 'p-6 md:p-8',
    className,
  ]}
>
  <div
    class:list={[
      'flex-1',
      media && 'grid gap-6 md:grid-cols-12 md:items-center',
      media && (narrow ? 'md:gap-6' : 'md:gap-10'),
    ]}
  >
    {
      media &&
        (cover ? (
          // Decorative here: the card's title already names the project.
          <Picture
            src={cover}
            alt=""
            widths={[480, 720, 960, 1280]}
            sizes={
              narrow
                ? '(min-width: 768px) 352px, 92vw'
                : '(min-width: 1152px) 640px, (min-width: 768px) 56vw, 92vw'
            }
            formats={['avif', 'webp']}
            class:list={[
              'w-full rounded-xl border border-line object-cover',
              // Narrow: a closer, taller crop on the central poses.
              narrow ? 'aspect-[16/10] object-[50%_40%] md:aspect-[4/3]' : 'aspect-[16/10] object-top',
            ]}
            pictureAttributes={{
              class: ['block', mediaSpan, reverse && 'md:order-2'].filter(Boolean).join(' '),
            }}
          />
        ) : (
          <MediaPlaceholder
            kind={media.kind}
            label={media.label}
            class:list={['aspect-[16/10]', mediaSpan, reverse && 'md:order-2']}
          />
        ))
    }

    <div
      class:list={[
        'relative flex flex-col',
        media ? ['px-3 pb-4 md:px-2', textSpan, narrow ? 'md:py-2' : 'md:py-6'] : 'h-full',
      ]}
    >
      <span
        class:list={[
          'absolute top-0 text-muted transition-[color,transform] duration-200 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent',
          media ? ['right-3 md:right-2', narrow ? 'md:top-2' : 'md:top-6'] : 'right-0',
        ]}
        aria-hidden="true"
      >
        <ArrowUpRight size={20} weight="bold" />
      </span>
      <p class="font-mono text-xs text-muted">
        {contextLabel[context]} · {year}
      </p>
      <Heading
        class:list={[
          'mt-3 pr-8 leading-tight font-bold tracking-[-0.02em] text-balance',
          narrow ? 'text-[1.75rem] md:text-[1.875rem]' : media ? 'text-2xl md:text-[2rem]' : 'text-2xl',
        ]}
        transition:name={`project-title-${project.id}`}
      >
        {title}
      </Heading>
      {!narrow && <p class="mt-3 leading-relaxed text-pretty text-muted">{summary}</p>}
      <ul class="mt-auto flex flex-wrap gap-1.5 pt-5" aria-label="Tecnologías">
        {
          visibleStack.map((tech) => (
            <li class="rounded-lg border border-line px-2 py-0.5 font-mono text-xs text-muted">
              {tech}
            </li>
          ))
        }
        {
          hiddenCount > 0 && (
            <li class="px-1 py-0.5 font-mono text-xs text-muted">+{hiddenCount}</li>
          )
        }
      </ul>
    </div>
  </div>
</a>
