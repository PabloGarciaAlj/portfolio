---
import { getContent } from '../data/profile';
import { getLang, sectionId, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { experience } = getContent(lang);
---

<section
  id={sectionId('experience', lang)}
  aria-labelledby="experiencia-title"
  class="scroll-mt-16 border-y border-line bg-surface"
>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
    <h2 id="experiencia-title" class="text-4xl font-bold tracking-[-0.03em] md:text-5xl">
      {t.experience.title}
    </h2>

    {
      experience.map((job) => (
        <article class="mt-10 grid gap-8 md:mt-14 md:grid-cols-12 md:gap-10">
          <header class="md:col-span-4">
            <div class="md:sticky md:top-24">
              <h3 class="text-2xl font-bold tracking-[-0.02em]">{job.company}</h3>
              <p class="mt-1 text-muted">{job.companyDescription}</p>
              <dl class="mt-6 space-y-3 text-[0.9375rem]">
                <div>
                  <dt class="sr-only">{t.experience.role}</dt>
                  <dd class="font-medium">{job.role}</dd>
                </div>
                <div>
                  <dt class="sr-only">{t.experience.period}</dt>
                  <dd class="font-mono text-[0.8125rem] text-muted">{job.period}</dd>
                </div>
                <div>
                  <dt class="sr-only">{t.experience.location}</dt>
                  <dd class="font-mono text-[0.8125rem] text-muted">{job.location}</dd>
                </div>
              </dl>
            </div>
          </header>

          <div class="md:col-span-8">
            <ul class="space-y-5">
              {job.highlights.map((item) => (
                <li class="grid grid-cols-[1.25rem_1fr] text-lg leading-relaxed text-pretty">
                  <span class="mt-[0.8em] h-px w-2.5 bg-accent" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-10 border-t border-line pt-6">
              <h4 class="font-mono text-xs text-muted">{t.experience.stack}</h4>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {job.stack.map((tech) => (
                  <li class="rounded-lg border border-line px-2 py-0.5 font-mono text-xs text-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
