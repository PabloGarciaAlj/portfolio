---
import { ArrowRight } from '@phosphor-icons/react/ssr';
import ProjectCard from './ProjectCard.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const thesis = featured.filter((p) => p.data.context === 'tfg');
const internship = featured.filter((p) => p.data.context === 'prácticas');
const academic = featured.filter((p) => p.data.context === 'académico');
const others = projects.filter((p) => !p.data.featured);

// Asymmetric rhythm for the internship grid: 7/5, then 5/7.
const internshipSpans = ['md:col-span-7', 'md:col-span-5', 'md:col-span-5', 'md:col-span-7'];
---

<section
  id="proyectos"
  aria-labelledby="proyectos-title"
  class="mx-auto max-w-6xl scroll-mt-16 px-4 pt-8 pb-20 sm:px-6 md:pt-16 md:pb-28 lg:px-8"
>
  <h2 id="proyectos-title" class="text-4xl font-bold tracking-[-0.03em] md:text-5xl">Proyectos</h2>

  <div class="mt-10 space-y-4 md:mt-14">
    {
      thesis.map((project) => (
        <ProjectCard
          project={project}
          media={{ kind: 'model', label: 'Visor 3D del personaje (pendiente)' }}
        />
      ))
    }
  </div>

  {
    internship.length > 0 && (
      <section aria-labelledby="practicas-title" class="mt-16 md:mt-20">
        <div class="max-w-2xl">
          <h3 id="practicas-title" class="text-xl font-bold tracking-[-0.01em]">
            Prácticas en 1MillionBot
          </h3>
          <p class="mt-2 leading-relaxed text-muted">
            Proyectos para clientes de la empresa. Los describo sin nombres ni capturas por
            confidencialidad.
          </p>
        </div>
        <div class="mt-6 grid gap-4 md:grid-cols-12">
          {internship.map((project, i) => (
            <ProjectCard
              project={project}
              headingLevel="h4"
              class={internshipSpans[i % internshipSpans.length]}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    academic.length > 0 && (
      <div class="mt-16 space-y-4 md:mt-20">
        {academic.map((project) => (
          <ProjectCard
            project={project}
            media={{ kind: 'image', label: `Captura de ${project.data.title} (pendiente)` }}
            reverse
          />
        ))}
      </div>
    )
  }

  {
    others.length > 0 && (
      <div class="mt-16 md:mt-20">
      <h3 class="font-mono text-xs text-muted">Otros proyectos</h3>
      <ul class="mt-3 border-t border-line">
        {others.map((project) => (
          <li class="border-b border-line">
            <a
              href={`/proyectos/${project.id}/`}
              class="group flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-6"
            >
              <span class="font-mono text-xs whitespace-nowrap text-muted sm:w-28">
                {project.data.year}
              </span>
              <span class="font-medium" transition:name={`project-title-${project.id}`}>
                {project.data.title}
              </span>
              <span class="flex-1 text-muted">{project.data.summary}</span>
              <span
                class="hidden text-muted transition-[color,transform] duration-200 ease-out group-hover:translate-x-0.5 group-hover:text-accent sm:block"
                aria-hidden="true"
              >
                <ArrowRight size={18} weight="bold" />
              </span>
            </a>
          </li>
        ))}
      </ul>
      </div>
    )
  }
</section>
