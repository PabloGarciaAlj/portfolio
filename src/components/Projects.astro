---
import { ArrowRight } from '@phosphor-icons/react/ssr';
import ProjectCard from './ProjectCard.astro';
import KatanaBackdrop from './katana/KatanaBackdrop.tsx';
import { getProjects, projectSlug } from '../lib/projects';
import { getLang, projectPath, sectionId, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const projects = await getProjects(lang);
const featured = projects.filter((p) => p.data.featured);
const thesis = featured.filter((p) => p.data.context === 'tfg');
const internship = featured.filter((p) => p.data.context === 'prácticas');
const academic = featured.filter((p) => p.data.context === 'académico');
const others = projects.filter((p) => !p.data.featured);
---

<section
  id={sectionId('projects', lang)}
  aria-labelledby="proyectos-title"
  class="katana-section mx-auto max-w-6xl scroll-mt-16 px-4 pt-8 pb-20 sm:px-6 md:pt-16 md:pb-28 lg:px-8"
>
  <h2 id="proyectos-title" class="text-4xl font-bold tracking-[-0.03em] md:text-5xl">{t.projects.title}</h2>

  <div class="mt-10 space-y-4 md:mt-14">
    {
      thesis.map((project) => {
        const backdrop = project.data.backdrop;
        const card = (
          <ProjectCard
            project={project}
            media={{ kind: 'model', label: t.projects.modelPending }}
            narrow={!!backdrop}
          />
        );
        return backdrop ? (
          <KatanaBackdrop
            client:idle
            src={backdrop.src}
            poster={{ src: backdrop.poster.src, width: backdrop.poster.width, height: backdrop.poster.height }}
          >
            {card}
          </KatanaBackdrop>
        ) : (
          card
        );
      })
    }
  </div>

  {
    internship.length > 0 && (
      <section aria-labelledby="practicas-title" class="mt-16 md:mt-20">
        <div class="max-w-2xl">
          <h3 id="practicas-title" class="text-xl font-bold tracking-[-0.01em]">
            {t.projects.internshipTitle}
          </h3>
          <p class="mt-2 leading-relaxed text-muted">
            {t.projects.internshipIntro}
          </p>
        </div>
        {/* Client work has no images or detail page: a compact list, not cards. */}
        <ul class="mt-6 divide-y divide-line border-t border-line">
          {internship.map((project) => (
            <li class="grid gap-2 py-5 md:grid-cols-12 md:gap-10">
              <h4 class="font-semibold leading-snug text-balance md:col-span-5">
                {project.data.title}
              </h4>
              <div class="md:col-span-7">
                <p class="leading-relaxed text-pretty text-muted">{project.data.summary}</p>
                <p class="mt-2 font-mono text-xs text-muted">
                  <span class="sr-only">{t.projects.stack}: </span>
                  {project.data.stack.slice(0, 5).join(', ')}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    academic.length > 0 && (
      <div class="mt-16 space-y-4 md:mt-20">
        {academic.map((project) => (
          <ProjectCard
            project={project}
            media={{ kind: 'image', label: t.projects.screenshotPending(project.data.title) }}
            reverse
          />
        ))}
      </div>
    )
  }

  {
    others.length > 0 && (
      <div class="mt-16 md:mt-20">
      <h3 class="font-mono text-xs text-muted">{t.projects.others}</h3>
      <ul class="mt-3 border-t border-line">
        {others.map((project) => (
          <li class="border-b border-line">
            <a
              href={projectPath(projectSlug(project), lang)}
              class="group flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-6"
            >
              <span class="font-mono text-xs whitespace-nowrap text-muted sm:w-28">
                {project.data.year}
              </span>
              <span class="font-medium" transition:name={`project-title-${projectSlug(project)}`}>
                {project.data.title}
              </span>
              <span class="flex-1 text-muted">{project.data.summary}</span>
              <span
                class="hidden text-muted transition-[color,transform] duration-200 ease-out group-hover:translate-x-0.5 group-hover:text-accent sm:block"
                aria-hidden="true"
              >
                <ArrowRight size={18} weight="bold" />
              </span>
            </a>
          </li>
        ))}
      </ul>
      </div>
    )
  }
</section>
