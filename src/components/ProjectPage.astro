---
import { render } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { ArrowLeft, ArrowRight, ArrowUpRight } from '@phosphor-icons/react/ssr';
// Project detail page, shared by /proyectos/[slug] and /en/projects/[slug].
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import MediaPlaceholder from './MediaPlaceholder.astro';
import CharacterViewer from './CharacterViewer.tsx';
import { projectSlug, type Project } from '../lib/projects';
import { getContent } from '../data/profile';
import { getLang, projectPath, sectionId, sectionPath, useTranslations } from '../i18n/ui';

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project, prev, next } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { profile } = getContent(lang);
const slug = projectSlug(project);
const { title, summary, context, year, role, stack, links, confidential, model, cover, coverAlt, gallery } =
  project.data;
const { Content } = await render(project);

// Poster and download size for the 3D viewer, resolved at build time.
const modelPoster = model
  ? await getImage({ src: model.poster, width: 1600, format: 'webp' })
  : null;
const modelSize = model
  ? `${Math.round(statSync(join(process.cwd(), 'public', model.src)).size / 1e6)} MB`
  : null;
---

<BaseLayout title={`${title} · ${profile.name}`} description={summary}>
  <SiteHeader />
  <main id={sectionId('content', lang)} class="mx-auto max-w-6xl px-4 pt-6 pb-20 sm:px-6 md:pt-8 md:pb-28 lg:px-8">
    <a href={sectionPath('projects', lang)} class="link inline-flex items-center gap-2 text-[0.9375rem] text-muted">
      <ArrowLeft size={16} weight="bold" aria-hidden="true" />
      {t.project.back}
    </a>

    {/* The work leads: title and summary stay compact so the main media lands in
        the first viewport. Role and stack move below it. */}
    <header class="mt-6 grid gap-4 md:mt-8 lg:grid-cols-12 lg:items-end lg:gap-x-10">
      <div class="lg:col-span-8">
        <p class="font-mono text-xs text-muted">{t.context[context]} · {year}</p>
        <h1
          class="mt-3 text-4xl leading-[1.05] font-bold tracking-[-0.03em] text-balance md:text-6xl"
          transition:name={`project-title-${slug}`}
        >
          {title}
        </h1>
      </div>
      <p class="text-lg leading-relaxed text-pretty text-muted lg:col-span-4">{summary}</p>
    </header>

    {
      model && modelPoster && modelSize ? (
        <div class="mt-6 md:mt-8 lg:[&_figure]:aspect-auto lg:[&_figure]:h-[clamp(26rem,calc(100dvh-22rem),42.5rem)] lg:[&_figure>img]:object-contain">
          <CharacterViewer
            client:visible
            src={model.src}
            size={modelSize}
            alt={model.alt}
            idle={model.idle}
            animations={model.animations}
            labels={t.viewer}
            poster={{
              src: modelPoster.src,
              width: Number(modelPoster.attributes.width),
              height: Number(modelPoster.attributes.height),
            }}
          />
        </div>
      ) : cover ? (
        <Picture
          src={cover}
          alt={coverAlt ?? t.projects.screenshotOf(title)}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 1152px) 1088px, 92vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="mt-6 w-full rounded-xl border border-line md:mt-8 lg:mx-auto lg:max-h-[max(26rem,calc(100dvh-22rem))] lg:w-auto lg:max-w-full"
        />
      ) : !confidential && (
        <MediaPlaceholder
          kind={context === 'tfg' ? 'model' : 'image'}
          label={context === 'tfg' ? t.projects.modelPending : t.projects.imagePending}
          class="mt-6 aspect-[16/9] md:mt-8 lg:aspect-auto lg:h-[clamp(26rem,calc(100dvh-22rem),38rem)]"
        />
      )
    }

    <dl class="mt-10 grid gap-6 border-y border-line py-6 sm:grid-cols-3">
      <div>
        <dt class="font-mono text-xs text-muted">{t.project.role}</dt>
        <dd class="mt-1">{role}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-muted">{t.project.context}</dt>
        <dd class="mt-1">{t.context[context]}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-muted">{t.project.stack}</dt>
        <dd class="mt-1">{stack.join(', ')}</dd>
      </div>
    </dl>

    <article
      class="mt-12 max-w-[68ch] text-lg leading-relaxed [&_h2]:mt-12 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-[-0.02em] [&_li]:text-muted [&_li]:marker:text-line-strong [&_li+li]:mt-2 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:text-muted [&_p+ol]:mt-4 [&_p+p]:mt-4 [&_p+ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6 [&_strong]:font-medium [&_strong]:text-ink [&_code]:font-mono [&_code]:text-[0.85em]"
    >
      <Content />
    </article>

    {
      gallery && gallery.length > 0 && (
        <section aria-labelledby="galeria-title" class="mt-16">
          <h2 id="galeria-title" class="text-2xl font-bold tracking-[-0.02em]">
            {t.project.gallery}
          </h2>
          {/* Portrait (phone) captures pair up side by side at every width, so on
              phones they don't stack into several screens of scroll. */}
          <div class="mt-6 grid grid-cols-2 items-start gap-x-3 gap-y-10 sm:gap-x-4">
            {gallery.map((item) => {
              const landscape = item.src.width >= item.src.height;
              return (
                <figure class:list={[landscape ? 'col-span-2' : 'mx-auto w-full max-w-sm']}>
                  <Picture
                    src={item.src}
                    alt={item.alt}
                    widths={landscape ? [640, 960, 1280, 1920] : [360, 540, 720]}
                    sizes={
                      landscape ? '(min-width: 1152px) 1088px, 92vw' : '(min-width: 768px) 384px, 46vw'
                    }
                    formats={['avif', 'webp']}
                    class="w-full rounded-xl border border-line"
                  />
                  {item.caption && (
                    <figcaption class="mt-3 font-mono text-xs leading-relaxed text-muted">
                      {item.caption}
                    </figcaption>
                  )}
                </figure>
              );
            })}
          </div>
        </section>
      )
    }

    {
      links && (links.demo || links.repo) && (
        <div class="mt-10 flex flex-wrap gap-3">
          {links.demo && (
            <a href={links.demo} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              {t.project.demo}
              <ArrowUpRight size={16} weight="bold" aria-hidden="true" />
            </a>
          )}
          {links.repo && (
            <a href={links.repo} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
              {t.project.repo}
              <ArrowUpRight size={16} weight="bold" aria-hidden="true" />
            </a>
          )}
        </div>
      )
    }

    <nav aria-label={t.project.others} class="mt-20 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
      {
        prev ? (
          <a href={projectPath(projectSlug(prev), lang)} class="group">
            <span class="flex items-center gap-2 font-mono text-xs text-muted">
              <ArrowLeft size={14} weight="bold" aria-hidden="true" />
              {t.project.prev}
            </span>
            <span class="mt-2 block font-medium group-hover:text-accent">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={projectPath(projectSlug(next), lang)} class="group sm:text-right">
            <span class="flex items-center gap-2 font-mono text-xs text-muted sm:justify-end">
              {t.project.next}
              <ArrowRight size={14} weight="bold" aria-hidden="true" />
            </span>
            <span class="mt-2 block font-medium group-hover:text-accent">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </main>
  <SiteFooter />
</BaseLayout>
