---
import { skills } from '../data/profile';
---

<section
  id="habilidades"
  aria-labelledby="habilidades-title"
  class="mx-auto max-w-6xl scroll-mt-16 px-4 py-20 sm:px-6 md:py-28 lg:px-8"
>
  <h2 id="habilidades-title" class="text-4xl font-bold tracking-[-0.03em] md:text-5xl">
    Habilidades
  </h2>

  <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-10 md:mt-14 lg:grid-cols-4">
    {
      skills.map((skill) => (
        <div class="border-t border-line-strong pt-4">
          <dt class="font-mono text-xs text-muted">{skill.group}</dt>
          <dd class="mt-3">
            <ul class="space-y-1.5 leading-snug">
              {skill.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
