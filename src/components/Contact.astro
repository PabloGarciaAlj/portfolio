---
import {
  DownloadSimpleIcon,
  EnvelopeSimpleIcon,
  GithubLogoIcon,
  LinkedinLogoIcon,
} from '@phosphor-icons/react/ssr';
import { getContent } from '../data/profile';
import { getLang, sectionId, useTranslations } from '../i18n/ui';
import CvLanguage from './CvLanguage.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { profile } = getContent(lang);

const socials = [
  { label: 'LinkedIn', href: profile.linkedin, Icon: LinkedinLogoIcon },
  { label: 'GitHub', href: profile.github, Icon: GithubLogoIcon },
];
---

<section
  id={sectionId('contact', lang)}
  aria-labelledby="contacto-title"
  class="scroll-mt-16 border-t border-line"
>
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
    <h2 id="contacto-title" class="text-4xl font-bold tracking-[-0.03em] md:text-5xl">{t.contact.title}</h2>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">
      {profile.availability}. {t.contact.writeTo}
    </p>

    {/* The address is shown to read or copy (one click selects it all); the
        mail action lives in the primary button, so there is one CTA per intent. */}
    <p
      class="mt-5 text-xl leading-tight font-medium tracking-[-0.02em] break-all select-all sm:text-2xl sm:break-normal md:text-3xl"
    >
      {profile.email}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a href={`mailto:${profile.email}`} class="btn btn-primary">
        <EnvelopeSimpleIcon size={18} weight="bold" aria-hidden="true" />
        {t.contact.sendEmail}
      </a>
      {
        socials.map(({ label, href, Icon }) => (
          <a href={href} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            <Icon size={18} weight="bold" aria-hidden="true" />
            {label}
            <span class="sr-only">({t.nav.newTab})</span>
          </a>
        ))
      }
      <a href={profile.cv} download hreflang="es" class="btn btn-secondary">
        <DownloadSimpleIcon size={18} weight="bold" aria-hidden="true" />
        {t.hero.downloadCv}
        <CvLanguage />
      </a>
    </div>
  </div>
</section>
