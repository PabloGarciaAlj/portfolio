---
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import { ArrowLeft, ArrowRight, ArrowUpRight } from '@phosphor-icons/react/ssr';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import { contextLabel, getProjects, type Project } from '../../lib/projects';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project, prev, next } = Astro.props;
const { title, summary, context, year, role, stack, links, confidential, model, cover, coverAlt, gallery } =
  project.data;
const { Content } = await render(project);
---

<BaseLayout title={`${title} · ${profile.name}`} description={summary}>
  <SiteHeader />
  <main id="contenido" class="mx-auto max-w-6xl px-4 pt-10 pb-20 sm:px-6 md:pt-14 md:pb-28 lg:px-8">
    <a href="/#proyectos" class="link inline-flex items-center gap-2 text-[0.9375rem] text-muted">
      <ArrowLeft size={16} weight="bold" aria-hidden="true" />
      Todos los proyectos
    </a>

    <header class="mt-10 max-w-3xl">
      <p class="font-mono text-xs text-muted">{contextLabel[context]} · {year}</p>
      <h1
        class="mt-4 text-4xl leading-[1.05] font-bold tracking-[-0.03em] text-balance md:text-6xl"
        transition:name={`project-title-${project.id}`}
      >
        {title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-pretty text-muted md:text-xl">{summary}</p>
    </header>

    <dl class="mt-10 grid gap-6 border-y border-line py-6 sm:grid-cols-3">
      <div>
        <dt class="font-mono text-xs text-muted">Rol</dt>
        <dd class="mt-1">{role}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-muted">Contexto</dt>
        <dd class="mt-1">{contextLabel[context]}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-muted">Tecnologías</dt>
        <dd class="mt-1">{stack.join(', ')}</dd>
      </div>
    </dl>

    {
      cover ? (
        <Picture
          src={cover}
          alt={coverAlt ?? `Captura de ${title}`}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 1152px) 1088px, 92vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="mt-10 w-full rounded-xl border border-line"
        />
      ) : !confidential && (
        <MediaPlaceholder
          kind={context === 'tfg' || model ? 'model' : 'image'}
          label={context === 'tfg' ? 'Visor 3D del personaje (pendiente)' : 'Imagen principal (pendiente)'}
          class="mt-10 aspect-[16/9]"
        />
      )
    }

    <article
      class="mt-12 max-w-[68ch] text-lg leading-relaxed [&_h2]:mt-12 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-[-0.02em] [&_li]:text-muted [&_li]:marker:text-line-strong [&_li+li]:mt-2 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:text-muted [&_p+ol]:mt-4 [&_p+p]:mt-4 [&_p+ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6 [&_strong]:font-medium [&_strong]:text-ink [&_code]:font-mono [&_code]:text-[0.85em]"
    >
      <Content />
    </article>

    {
      gallery && gallery.length > 0 && (
        <section aria-labelledby="galeria-title" class="mt-16">
          <h2 id="galeria-title" class="text-2xl font-bold tracking-[-0.02em]">
            Capturas
          </h2>
          <div class="mt-6 grid items-start gap-x-4 gap-y-10 md:grid-cols-2">
            {gallery.map((item) => {
              const landscape = item.src.width >= item.src.height;
              return (
                <figure class:list={[landscape ? 'md:col-span-2' : 'mx-auto w-full max-w-sm']}>
                  <Picture
                    src={item.src}
                    alt={item.alt}
                    widths={landscape ? [640, 960, 1280, 1920] : [360, 540, 720]}
                    sizes={
                      landscape ? '(min-width: 1152px) 1088px, 92vw' : '(min-width: 768px) 384px, 92vw'
                    }
                    formats={['avif', 'webp']}
                    class="w-full rounded-xl border border-line"
                  />
                  {item.caption && (
                    <figcaption class="mt-3 font-mono text-xs leading-relaxed text-muted">
                      {item.caption}
                    </figcaption>
                  )}
                </figure>
              );
            })}
          </div>
        </section>
      )
    }

    {
      links && (links.demo || links.repo) && (
        <div class="mt-10 flex flex-wrap gap-3">
          {links.demo && (
            <a href={links.demo} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              Ver en producción
              <ArrowUpRight size={16} weight="bold" aria-hidden="true" />
            </a>
          )}
          {links.repo && (
            <a href={links.repo} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
              Repositorio
              <ArrowUpRight size={16} weight="bold" aria-hidden="true" />
            </a>
          )}
        </div>
      )
    }

    <nav aria-label="Otros proyectos" class="mt-20 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
      {
        prev ? (
          <a href={`/proyectos/${prev.id}/`} class="group">
            <span class="flex items-center gap-2 font-mono text-xs text-muted">
              <ArrowLeft size={14} weight="bold" aria-hidden="true" />
              Anterior
            </span>
            <span class="mt-2 block font-medium group-hover:text-accent">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/proyectos/${next.id}/`} class="group sm:text-right">
            <span class="flex items-center gap-2 font-mono text-xs text-muted sm:justify-end">
              Siguiente
              <ArrowRight size={14} weight="bold" aria-hidden="true" />
            </span>
            <span class="mt-2 block font-medium group-hover:text-accent">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </main>
  <SiteFooter />
</BaseLayout>
