---
// A static site has a single 404 for every URL, so it stays in Spanish (the
// default language) with a short way into the English version.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getContent } from '../data/profile';
import { homePath, sectionPath } from '../i18n/ui';

const { profile } = getContent('es');
---

<BaseLayout
  title={`Página no encontrada · ${profile.name}`}
  description="Esta página no existe. Vuelve al inicio para ver los proyectos y el contacto."
>
  <SiteHeader />
  <main
    id="contenido"
    class="mx-auto flex min-h-[60dvh] max-w-6xl flex-col justify-center px-4 py-20 sm:px-6 lg:px-8"
  >
    <p class="font-mono text-xs text-muted">Error 404</p>
    <h1 class="mt-3 text-4xl leading-[1.05] font-bold tracking-[-0.03em] text-balance md:text-6xl">
      Esta página no existe
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">
      Puede que el enlace esté mal escrito o que la página se haya movido.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={homePath('es')} class="btn btn-primary">Volver al inicio</a>
      <a href={sectionPath('projects', 'es')} class="btn btn-secondary">Ver proyectos</a>
    </div>
    <p lang="en" class="mt-10 text-muted">
      This page doesn't exist.
      <a href={homePath('en')} hreflang="en" class="link font-medium text-ink">Go to the English site</a>
    </p>
  </main>
  <SiteFooter />
</BaseLayout>
